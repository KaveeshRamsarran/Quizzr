# Quizzr configuration. Copy to .env (repo root or backend/) and edit as needed.
# Every value is optional: with no .env at all Quizzr runs on SQLite.

# Database (defaults to backend/quizzr.db)
# DATABASE_URL=postgresql://quizzr:quizzr@localhost:5432/quizzr

# Signing key for login tokens. If unset, a random key is created in backend/.secret_key.
# SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Uploads
MAX_UPLOAD_SIZE_MB=50
STORAGE_QUOTA_MB=500
# UPLOAD_DIR=./uploads

# Allowed browser origin in production (development also allows localhost:3000/5173)
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
