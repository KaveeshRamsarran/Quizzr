# Quizzr configuration. Copy to .env (repo root or backend/) and edit as needed.
# Every value is optional: with no .env at all Quizzr runs on SQLite.

# Database (defaults to backend/quizzr.db)
# DATABASE_URL=postgresql://quizzr:quizzr@localhost:5432/quizzr
# Supabase: use the Session pooler string from Connect, e.g.
# DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Signing key for login tokens. If unset, a random key is created in backend/.secret_key.
# SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase Auth (optional). Set both to sign people in through Supabase instead of
# Quizzr's own accounts. See "Deploying with Supabase" in README.md.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional, but needed on hosts without a lasting disk (Render): stores uploaded PDFs in a
# private Supabase Storage bucket, and deletes the Supabase user too when someone deletes
# their account. Server-side only; keep it secret.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=documents
# Optional: OAuth providers enabled in Supabase, shown as "Continue with ..." buttons.
# SUPABASE_OAUTH_PROVIDERS=google,github
# Only for projects still using the legacy JWT secret (new projects use signing keys).
# SUPABASE_JWT_SECRET=

# Uploads
MAX_UPLOAD_SIZE_MB=50
STORAGE_QUOTA_MB=500
# UPLOAD_DIR=./uploads

# Allowed browser origin in production (development also allows localhost:3000/5173)
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
